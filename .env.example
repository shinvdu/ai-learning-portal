APP_ENV=development
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

DATABASE_URL=postgres://portal:portal@127.0.0.1:5433/ai_portal
REDIS_URL=redis://127.0.0.1:6380/0
PUBLIC_BASE_URL=http://127.0.0.1:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-use
MFA_ENC_KEY=

MAIL_TRANSPORT=console
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM='AI Learning Portal <no-reply@example.com>'

# P1 SMTP transport (opt-in). MAIL_TRANSPORT=smtp requires SMTP_URL.
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# P1 media storage. local keeps files on disk; s3 uses MinIO/AWS.
STORAGE_DRIVER=local
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=52428800
# S3 endpoint is optional for AWS; MinIO needs it plus path-style requests.
# S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=1
# S3_PUBLIC_URL=

SEED_DEMO_RECORDS=1
ALLOW_DEMO_RESET=1

LOG_LEVEL=info
ENABLE_API_DOCS=0
SERVE_WEB=1