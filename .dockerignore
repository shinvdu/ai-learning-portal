# Build context exclusions for both images (context = repository root).
# Keep package-lock.json, package.json manifests, packages/db/drizzle and
# packages/db/fixtures: the API image builds from and serves those at runtime.

# Dependencies and local build output (rebuilt inside the image)
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo

# VCS / tooling
.git
.gitignore
.github
.editorconfig
prettier.config.mjs
eslint.config.js
vitest.config.ts
playwright.config.ts

# Secrets and local env files (templates are not selected by *.env patterns)
.env
.env.*
**/.env
**/.env.*

# Local databases and backups
data/*.db
data/*.db-shm
data/*.db-wal
backups

# Documentation, QA artifacts and screenshots
docs
test-results
playwright-report
coverage
*.md

# v1 zero-dependency app (kept on main, not used by v2 images)
/server.js
/src
/public
start.sh
start.bat