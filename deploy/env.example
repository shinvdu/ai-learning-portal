# Environment template for deploy/compose.prod.yml.
#
#   cp deploy/env.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# Never commit a filled-in .env.prod. Always pass this file with `--env-file`;
# compose interpolates these values into every service's `environment:`:
#
#   docker compose -p portalprod -f deploy/compose.prod.yml \
#     --env-file deploy/.env.prod up -d
#
# Values below are placeholders; replace every "replace-with-*" value.

APP_ENV=production
NODE_ENV=production

# PostgreSQL bootstrap (interpolated by compose). Keep POSTGRES_PASSWORD
# identical to the password inside DATABASE_URL. Workshop defaults are
# portal/portal; replace both for any non-local deployment.
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=ai_portal

# Compose service names (not localhost): the API talks to postgres/redis on the
# internal network. Host ports are not published by the production compose.
DATABASE_URL=postgres://portal:replace-with-db-password@postgres:5432/ai_portal
REDIS_URL=redis://redis:6379/0

# Public URL users open in the browser (used in verification/reset links).
# With Docker compose this is http://127.0.0.1:8080 unless a TLS proxy fronts it.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# First-run administrator. ADMIN_PASSWORD is never printed or logged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# AES-256-GCM key material for stored MFA secrets. Any long random secret is
# accepted and SHA-256-derived; use at least 32 random bytes, e.g.:
#   openssl rand -base64 32
# Rotating this invalidates existing MFA enrolments.
MFA_ENC_KEY=replace-with-32-plus-random-bytes-base64

# Mail: `webhook` posts {from,to,subject,text,html} with a Bearer token.
# `smtp` sends through nodemailer; `console` is rejected in production.
MAIL_TRANSPORT=webhook
MAIL_WEBHOOK_URL=https://mail-relay.example.com/send
MAIL_WEBHOOK_TOKEN=replace-with-relay-token
MAIL_FROM='AI Learning Portal <no-reply@example.com>'

# P1 SMTP transport. Set MAIL_TRANSPORT=smtp instead of webhook to use it;
# SMTP_URL is then required at startup.
# SMTP_URL=smtps://user:replace-with-password@smtp.example.com:465

# P1 media storage. local is the default and keeps uploads on the API volume.
# Switch to s3 to share media across instances (MinIO or AWS); S3_BUCKET,
# S3_ACCESS_KEY and S3_SECRET_KEY are then required. S3_ENDPOINT is optional
# for AWS and required for MinIO; MinIO also needs force path style.
STORAGE_DRIVER=local
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=52428800
# S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# S3_BUCKET=portal-media
# S3_ACCESS_KEY=replace-with-access-key
# S3_SECRET_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=1
# S3_PUBLIC_URL=https://media.example.com

# Demo data. This compose file runs the seed job with --demo-records, so keep
# SEED_DEMO_RECORDS=1 for the workshop demo. For a real deployment: set 0 and
# remove --demo-records from the seed command in deploy/compose.prod.yml.
SEED_DEMO_RECORDS=1
# Admin "reset demo data" is destructive; leave disabled unless intended.
ALLOW_DEMO_RESET=0

LOG_LEVEL=info
# Expose /api/v1/openapi.json + Scalar docs only when explicitly enabled.
ENABLE_API_DOCS=0

# Production uses Nginx (web service) for static files; the API must not serve
# the SPA. TRUST_PROXY=1 makes the API honour X-Forwarded-* from Nginx.
SERVE_WEB=0
TRUST_PROXY=1

# TLS and mail in real deployments:
# - Terminate TLS at an edge proxy (or nginx.conf.example) and forward
#   X-Forwarded-Proto=https; add HSTS there, not on the plain :80 web container.
# - Set PUBLIC_BASE_URL to the https origin so emailed links are correct.
# - Use either MAIL_TRANSPORT=smtp with SMTP_URL, or MAIL_TRANSPORT=webhook
#   pointing MAIL_WEBHOOK_URL at an authenticated relay you control.