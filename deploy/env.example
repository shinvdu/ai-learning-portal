# Copy to /etc/ai-learning-portal.env and restrict permissions (chmod 600).
APP_ENV=production
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=1

PORTAL_DB=/var/lib/ai-learning-portal/portal.db
PUBLIC_BASE_URL=https://learning.example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

MAIL_WEBHOOK_URL=https://mail-relay.example.com/send
MAIL_WEBHOOK_TOKEN=replace-with-relay-token
MAIL_FROM='AI Learning Portal <no-reply@example.com>'

# Production defaults to skipping demo learning records.
SEED_DEMO_RECORDS=0