# Example Nginx reverse proxy for AI Learning Portal.
# Terminate TLS here, keep the Node process on 127.0.0.1:8787.

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=600r/m;

server {
    listen 80;
    server_name learning.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name learning.example.com;

    ssl_certificate     /etc/letsencrypt/live/learning.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learning.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 2m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;

    # Tighten login/register/reset/verification endpoints at the edge too.
    location /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }

    location /api/ {
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }

    # Health endpoints should be internal-only in production.
    location = /healthz {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8787;
    }
    location = /readyz {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8787;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
    }
}