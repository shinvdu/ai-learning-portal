# Environment file for deploy/systemd/ai-learning-portal.service.
#
#   sudo install -o root -g root -m 0600 \
#     deploy/systemd/ai-learning-portal.env.example /etc/ai-learning-portal.env
#   # then edit /etc/ai-learning-portal.env and replace every placeholder
#
# systemd EnvironmentFile syntax: one KEY=value per line, NO shell expansion
# (no ${VAR}, no $(command), no ~). Values containing spaces must be quoted.
# Never commit the filled-in /etc/ai-learning-portal.env.
#
# The API validates this file at start-up (packages/config/src/env.ts). In
# production APP_ENV/NODE_ENV=production it refuses to boot unless DATABASE_URL,
# REDIS_URL, PUBLIC_BASE_URL, MFA_ENC_KEY and ADMIN_PASSWORD are set and the mail
# transport is webhook/smtp (console is rejected).

APP_ENV=production
NODE_ENV=production

# The systemd unit runs the API on loopback; Nginx (deploy/nginx) fronts it.
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=1
# Nginx serves the SPA; the API must not.
SERVE_WEB=0

# PostgreSQL 16 and Redis 7. Point at the real hosts/ports; TLS-encrypt remote
# connections (e.g. ?sslmode=require on DATABASE_URL).
DATABASE_URL=postgres://portal:replace-with-db-password@127.0.0.1:5432/ai_portal
# Optional: a separate role/URL for migrations; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

# Public https origin used in verification/reset e-mails and CSRF origin checks.
PUBLIC_BASE_URL=https://learning.example.com

# First-run administrator. ADMIN_PASSWORD is never printed or logged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# AES-256-GCM key material for stored MFA secrets, at least 32 random bytes,
# base64-encoded. Generate on a trusted host: openssl rand -base64 32
# Rotating it invalidates existing MFA enrolments.
MFA_ENC_KEY=replace-with-base64-of-at-least-32-random-bytes

# Mail. `webhook` POSTs {from,to,subject,text,html} with a Bearer token.
MAIL_TRANSPORT=webhook
MAIL_WEBHOOK_URL=https://mail-relay.example.com/send
MAIL_WEBHOOK_TOKEN=replace-with-relay-token
MAIL_FROM="AI Learning Portal <no-reply@example.com>"

# Demo/seed behaviour: off in a real deployment.
SEED_DEMO_RECORDS=0
ALLOW_DEMO_RESET=0

LOG_LEVEL=info
ENABLE_API_DOCS=0