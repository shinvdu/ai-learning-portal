[Unit]
Description=AI Learning Portal
After=network.target

[Service]
Type=simple
User=ai-portal
Group=ai-portal
WorkingDirectory=/opt/ai-learning-portal
EnvironmentFile=/etc/ai-learning-portal.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-learning-portal /opt/ai-learning-portal/backups

[Install]
WantedBy=multi-user.target